<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        x:Class="PackDepTool.App.Views.DisabledModsDialog"
        x:DataType="vm:DisabledModsViewModel"
        Title="管理已禁用模组"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,12">
      <Border Width="42" Height="3" CornerRadius="2" Background="{DynamicResource Accent}"
              HorizontalAlignment="Left" Margin="0,0,0,7" />
      <TextBlock Text="管理已禁用模组" Classes="title" FontSize="18" />
      <TextBlock Text="将 .jar 重命名为 .jar.disabled 即可禁用。选中后启用，或一键全部启用。"
                 Classes="caption" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="12" Padding="8">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DisabledModItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,3">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FileName}" FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SizeText}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ModifiedText}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="启用后会重新扫描并写入模组历史。" Classes="caption" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="关闭" Command="{Binding CancelCommand}" />
        <Button Content="启用选中" Command="{Binding EnableSelectedCommand}" />
        <Button Content="全部启用" Classes="accent" Command="{Binding EnableAllCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
