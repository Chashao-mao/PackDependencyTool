<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        xmlns:persistence="using:PackDepTool.Core.Persistence"
        x:Class="PackDepTool.App.Views.BackupCenterDialog"
        x:DataType="vm:BackupCenterViewModel"
        Title="备份中心"
        Width="920"
        Height="640"
        MinWidth="780"
        MinHeight="520"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="3">
        <TextBlock Text="备份中心" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="修复前快照、配置备份与当前文件差异；恢复前请确认。"
                   Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="备份 config…" Command="{Binding BackupConfigCommand}"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="12">
      <Border Classes="card" Padding="8">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="快照列表" Classes="section" Margin="4,2,4,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Backups}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="persistence:PackBackupInfo">
                <StackPanel Spacing="2" Margin="2,3">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="chip" Padding="5,0">
                      <TextBlock Text="{Binding FileCount}" FontSize="9" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Detail}" FontSize="9.5"
                             Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
          <TextBlock Grid.Row="0" Text="文件差异" Classes="section" />
          <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Classes="caption" TextWrapping="Wrap" />
          <ListBox Grid.Row="2" ItemsSource="{Binding Diff}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="persistence:PackBackupDiffEntry">
                <Grid ColumnDefinitions="*,Auto" Margin="2,3">
                  <TextBlock Text="{Binding RelativePath}" FontSize="10.5"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="10"
                             Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="{Binding StatusText}" Classes="caption"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="恢复会覆盖当前同名文件；快照保存在 .packdep-backups。"
                 Classes="caption" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="删除快照" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanRestore}" />
        <Button Content="恢复选中" Classes="accent" Command="{Binding RestoreCommand}"
                IsEnabled="{Binding CanRestore}" />
        <Button Content="关闭" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
