<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        x:Class="PackDepTool.App.Views.DiagnosticReportDialog"
        x:DataType="vm:DiagnosticReportViewModel"
        Title="日志诊断"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,12">
      <TextBlock Text="日志诊断" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SourceText}" Classes="caption" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding FactsText}" IsVisible="{Binding HasFacts}" FontSize="10.5"
                 Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Summary}" FontSize="11.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
      <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,9"
              IsVisible="{Binding HasVerdict}" Margin="0,5,0,0">
        <StackPanel Spacing="3">
          <TextBlock Text="结论" FontSize="9" Foreground="{DynamicResource Accent}" />
          <TextBlock Text="{Binding VerdictTitle}" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding VerdictMessage}" FontSize="10.5"
                     Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DiagnosticFindingItem">
            <Border Classes="card" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Border Classes="chip" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SeverityText}" FontSize="9.5"
                               Foreground="{Binding SeverityBrush}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" FontSize="9"
                             Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding Message}" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding FixText}" IsVisible="{Binding HasFix}" FontSize="10"
                           TextWrapping="Wrap" Foreground="{DynamicResource Accent}" />
                <TextBlock Text="{Binding SourceText}" IsVisible="{Binding HasSource}" FontSize="9"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="{Binding RelatedText}" FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                <Border Background="{DynamicResource PanelAlt}" CornerRadius="6" Padding="8">
                  <TextBlock Text="{Binding Evidence}" FontFamily="Consolas" FontSize="9.5"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="诊断只基于日志文本，不代表启动验证；没有匹配项时不会猜测。"
                 Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" />
    </Grid>
  </Grid>
</Window>
