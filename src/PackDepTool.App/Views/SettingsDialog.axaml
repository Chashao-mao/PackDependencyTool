<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        x:Class="PackDepTool.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="620"
        Height="740"
        CanResize="True"
        MinWidth="560"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
      <TextBlock Text="设置" Classes="title" />
      <TextBlock Text="{Binding VersionLabel}" Classes="caption" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="0,0,8,0">

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="网络与 API" Classes="section" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="启用联网补全（Modrinth / CurseForge）" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding NetworkEnabled}" OnContent="开" OffContent="关" />
            </Grid>

            <TextBlock Text="游戏本体/加载器下载会自动在官方源与 BMCLAPI 之间回退；本版本没有独立的 Modrinth/CurseForge 镜像输入框，更新源也不是镜像站。"
                       Classes="caption" TextWrapping="Wrap" />

            <TextBlock Text="下载源与镜像（重启生效）" Classes="section" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
              <TextBlock Text="游戏文件下载源" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding GameSourceOptions}"
                        SelectedItem="{Binding SelectedGameSource, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameSourceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Text="Modrinth API 基址" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ModrinthApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="留空使用官方；镜像需填写完整 API 基址" />
              <TextBlock Grid.Row="2" Text="CurseForge API 基址" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurseForgeApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="留空使用官方；第三方镜像不会发送 API Key" />
              <TextBlock Grid.Row="3" Text="Mod CDN 基址" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ModCdnBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="例如 https://镜像站；留空不替换官方 CDN" />
            </Grid>
            <TextBlock Text="镜像为可选第三方服务；填写前请确认其条款和隐私政策。CurseForge 使用镜像时不会发送本地 API Key。"
                       Classes="caption" TextWrapping="Wrap" />

            <TextBlock Text="更新检查（可选）" Classes="section" Margin="0,6,0,0" />
            <TextBox Text="{Binding UpdateFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="https://raw.githubusercontent.com/&lt;owner&gt;/PackDependencyTool/main/update.json" />
            <CheckBox Content="启动后自动检查更新（默认关闭）"
                      IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}" />
            <CheckBox Content="发现新版本后自动下载"
                      IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}" />
            <CheckBox Content="下载后校验 SHA256 并自动重启更新（高风险，默认关闭）"
                      IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}"
                      IsEnabled="{Binding AutoDownloadUpdates}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Text="批量下载并发数（1–6）" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding MaxParallelDownloads, Mode=TwoWay}"
                             Minimum="1" Maximum="6" Increment="1" Width="120" />
            </Grid>

            <TextBlock Text="Modrinth 联系方式（写入 User-Agent，下次启动生效）" Classes="caption" />
            <TextBox Text="{Binding ModrinthContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="例如 you@example.com 或 GitHub 主页" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="CurseForge API Key" Classes="caption" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="chip" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KeyStatusText}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>

            <TextBox Text="{Binding KeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PasswordChar="●"
                     Watermark="输入新的 API Key（不会显示已保存的值）"
                     IsEnabled="{Binding !IsFromEnvironment}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="保存并验证" Command="{Binding SaveKeyCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="清除本地 Key" Classes="danger" Command="{Binding ClearKeyCommand}" />
              <TextBlock Text="{Binding Message}" Classes="caption" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </StackPanel>

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Key 使用 Windows DPAPI（当前用户）或本地 AES-256-GCM 加密保存，仅发送到 api.curseforge.com；不会写入日志、崩溃报告或界面。也可通过环境变量 CURSEFORGE_API_KEY 提供。" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="外观与布局" Classes="section" />

            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="主题" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Text="默认布局算法" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LayoutOptions}"
                        SelectedItem="{Binding SelectedLayout}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayoutOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="2" Text="显示节点标签" VerticalAlignment="Center" />
              <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowLabels}" Content="在图中绘制名称与 modId" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="默认显示的依赖关系" Classes="section" />
            <TextBlock Text="必需与不兼容关系始终显示；以下关系默认隐藏，可在主界面左侧随时切换。" Classes="caption" TextWrapping="Wrap" />
            <WrapPanel>
              <CheckBox IsChecked="{Binding ShowOptional}" Content="可选（optional）" Margin="0,0,18,0" />
              <CheckBox IsChecked="{Binding ShowEmbedded}" Content="内嵌（embedded）" Margin="0,0,18,0" />
              <CheckBox IsChecked="{Binding ShowRecommends}" Content="推荐（recommends）" Margin="0,0,18,0" />
              <CheckBox IsChecked="{Binding ShowManual}" Content="手动关系" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="本地数据" Classes="section" />
            <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" />
              <TextBlock Text="{Binding StorageDescription}" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="默认数据目录是程序同级的 data 文件夹，不再写入 %APPDATA%。可用环境变量 PACKDEP_DATA_DIR 指定其他位置；首次启动会把旧 AppData 数据复制过来。" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <TextBlock Text="设置立即生效（Modrinth User-Agent 除外）" Classes="caption" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="保存" Classes="accent" Command="{Binding SaveAndCloseCommand}" />
    </Grid>
  </Grid>
</Window>
