<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scanning="using:PackDepTool.Core.Scanning"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        xmlns:controls="using:PackDepTool.App.Controls"
        x:Class="PackDepTool.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pack Dependency Tool"
        Icon="avares://PackDependencyTool/Assets/app.png"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenInstancesCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RescanCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportJsonCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RelayoutCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="208,*">

    <!-- ============================ Navigation ============================ -->
    <Border Grid.Column="0" Background="{DynamicResource HeaderBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="10,12">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="2" Margin="4,0,4,18">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True">
              <Image Source="avares://PackDependencyTool/Assets/app.png" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Pack Dependency" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="Tool" FontSize="10" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="3">
          <TextBlock Text="工作空间" FontSize="9" Margin="10,0,0,3"
                     Foreground="{DynamicResource TextMuted}" />
          <Button Content="首页" Command="{Binding NavigateCommand}" CommandParameter="home"
                  Classes="nav" Classes.active="{Binding IsHomePage}" FontSize="12" MinHeight="36" />
          <Button Content="模组" Command="{Binding NavigateCommand}" CommandParameter="mods"
                  Classes="nav" Classes.active="{Binding IsModsPage}" FontSize="12" MinHeight="36" />
          <Button Content="诊断" Command="{Binding NavigateCommand}" CommandParameter="diagnostics"
                  Classes="nav" Classes.active="{Binding IsDiagnosticsPage}" FontSize="12" MinHeight="36" />
          <Button Content="服务端" Command="{Binding NavigateCommand}" CommandParameter="server"
                  Classes="nav" Classes.active="{Binding IsServerPage}" FontSize="12" MinHeight="36" />

        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5">
          <TextBlock Text="{Binding PackPathDisplay}" FontSize="9" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}" MaxHeight="45" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <TextBlock Text="{Binding VersionLabel}" FontSize="9" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" />
            <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Classes="ghost"
                    FontSize="11" Padding="2,0" MinHeight="18" MinWidth="20"
                    ToolTip.Tip="设置" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

    <!-- ============================ Header ============================ -->
    <Border Grid.Row="0"
            Background="{DynamicResource HeaderBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="0,0,0,1"
            Padding="14,9,14,8">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding ActivePageTitle}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActivePageSubtitle}" Classes="caption" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="扫描" Classes="accent" Command="{Binding RescanCommand}" ToolTip.Tip="F5 重新扫描当前整合包" />
            <Button Content="操作 ▾" ToolTip.Tip="实例、获取内容、导出、诊断、修复、设置">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="命令面板…" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+K" />
                  <Separator />
                  <MenuItem Header="实例与启动">
                    <MenuItem Header="实例管理…" Command="{Binding OpenInstancesCommand}" />
                    <MenuItem Header="启动当前实例" Command="{Binding LaunchCurrentInstanceCommand}" />
                  <MenuItem Header="启动前诊断" Command="{Binding DiagnoseLaunchCommand}" />
                    <MenuItem Header="打开 latest.log" Command="{Binding OpenLatestLogCommand}" />
                  <MenuItem Header="实时日志窗口" Command="{Binding OpenLogTailCommand}" />
                    <MenuItem Header="返回概览" Command="{Binding OpenOverviewCommand}" />
                    <Separator />
                    <MenuItem Header="打开整合包目录" Command="{Binding OpenPackFolderCommand}" />
                  </MenuItem>
                  <MenuItem Header="获取内容">
                    <MenuItem Header="补全在线资料…" Command="{Binding EnrichCommand}" />
                    <MenuItem Header="下载缺失依赖…" Command="{Binding AutoCompleteDependenciesCommand}"
                              IsEnabled="{Binding HasMissingDependencies}" />
                    <Separator />
                    <MenuItem Header="下载模组…" Command="{Binding DownloadModsCommand}" />
                    <MenuItem Header="下载整合包…" Command="{Binding DownloadModpackCommand}" />
                    <MenuItem Header="导入模组列表…" Command="{Binding ImportModListCommand}" />
                    <MenuItem Header="导入本地整合包…" Command="{Binding ImportLocalModpackCommand}" />
                    <MenuItem Header="合并整合包…" Command="{Binding MergeModpackCommand}"
                              ToolTip.Tip="按 modId 去重合并另一个整合包，目标优先。" />
                    <MenuItem Header="导入服务端整合包…" Command="{Binding ImportServerModpackCommand}"
                              ToolTip.Tip="只安装服务端需要的文件，并应用 server-overrides。" />
                    <Separator />
                    <MenuItem Header="游戏本体 / 加载器…" Command="{Binding OpenGameSetupCommand}" />
                    <MenuItem Header="切换加载器…" Command="{Binding OpenLoaderSwitchCommand}" />
                  </MenuItem>
                  <MenuItem Header="导出">
                    <MenuItem Header="JSON 图数据" Command="{Binding ExportJsonCommand}" />
                    <MenuItem Header="Graphviz DOT" Command="{Binding ExportDotCommand}" />
                    <MenuItem Header="GraphML" Command="{Binding ExportGraphMlCommand}" />
                    <MenuItem Header="CSV（节点 + 关系）" Command="{Binding ExportCsvCommand}" />
                    <MenuItem Header="关系图 PNG…" Command="{Binding ExportGraphPngCommand}" />
                    <MenuItem Header="Markdown 分析报告" Command="{Binding ExportReportCommand}" />
                    <MenuItem Header="整合包（.mrpack）" Command="{Binding ExportPclPackCommand}" />
                    <Separator />
                    <MenuItem Header="模组清单 Markdown…" Command="{Binding ExportModListCommand}" />
                    <MenuItem Header="缺失依赖清单…" Command="{Binding ExportMissingCommand}" />
                    <MenuItem Header="模组清单 CSV…" Command="{Binding ExportModListCsvCommand}" />
                    <MenuItem Header="模组列表长图（含依赖线）…" Command="{Binding ExportModListPngCommand}" />
                  </MenuItem>
                  <MenuItem Header="分析与诊断">
                    <MenuItem Header="一键体检向导…" Command="{Binding OpenHealthWizardCommand}" />
                    <MenuItem Header="整合包工具…" Command="{Binding OpenPackToolsCommand}" />
                    <MenuItem Header="崩溃日志诊断…" Command="{Binding DiagnoseCrashCommand}" />
                    <MenuItem Header="JAR 冲突扫描…" Command="{Binding ScanJarConflictsCommand}" />
                    <MenuItem Header="性能归因…" Command="{Binding AnalyzePerformanceCommand}" />
                    <MenuItem Header="数据包扫描…" Command="{Binding ScanDataPacksCommand}" />
                    <MenuItem Header="二分诊断…" Command="{Binding OpenBisectionCommand}" />
                    <Separator />
                    <MenuItem Header="服务端工具…" Command="{Binding OpenServerToolsCommand}" />
                  </MenuItem>
                  <MenuItem Header="修复与备份">
                    <MenuItem Header="禁用管理…" Command="{Binding OpenDisabledModsCommand}" />
                    <MenuItem Header="撤销上次修复" Command="{Binding UndoLastBackupCommand}"
                              IsEnabled="{Binding HasBackup}" />
                    <MenuItem Header="备份中心…" Command="{Binding OpenBackupCenterCommand}" />
                    <Separator />
                    <MenuItem Header="备份 config…" Command="{Binding BackupConfigCommand}" />
                    <MenuItem Header="恢复最近 config 备份…" Command="{Binding RestoreLastConfigCommand}"
                              IsEnabled="{Binding HasConfigBackup}" />
                  </MenuItem>
                  <MenuItem Header="发布与基线">
                    <MenuItem Header="创建发布基线…" Command="{Binding CreateVersionLockCommand}"
                              ToolTip.Tip="记录当前模组版本和文件 SHA1，作为发布/对比基线；不会锁定或自动更新模组。" />
                    <MenuItem Header="对比发布基线…" Command="{Binding CompareVersionLockCommand}"
                              ToolTip.Tip="查看基线之后新增、移除、版本变化和文件内容变化的模组。" />
                    <MenuItem Header="删除发布基线…" Command="{Binding DeleteVersionLockCommand}" />
                  </MenuItem>
                  <MenuItem Header="版本与视图">
                    <MenuItem Header="对比上次模组列表…" Command="{Binding CompareModListHistoryCommand}" />
                    <Separator />
                    <MenuItem Header="复制当前视图状态" Command="{Binding CopyViewStateCommand}" />
                    <MenuItem Header="应用剪贴板视图状态" Command="{Binding ApplyViewStateCommand}" />
                    <Separator />
                    <MenuItem Header="面板">
                      <MenuItem Header="收起 / 显示左栏" Click="ToggleLeftPanel_Click" />
                      <MenuItem Header="收起 / 显示右栏" Click="ToggleRightPanel_Click" />
                    </MenuItem>
                    <MenuItem Header="重新布局" Command="{Binding RelayoutCommand}"
                              IsVisible="{Binding IsGraphView}" />
                    <MenuItem Header="刷新在线图标" Command="{Binding RefreshOnlineIconsCommand}" />
                    <MenuItem Header="清空模组历史" Command="{Binding ClearHistoryCommand}" />
                  </MenuItem>
                  <MenuItem Header="更新与维护">
                    <MenuItem Header="更新中心" Command="{Binding OpenUpdateCenterCommand}" />
                    <MenuItem Header="全选可更新" Command="{Binding SelectUpdatableCommand}" />
                    <MenuItem Header="检查程序更新" Command="{Binding CheckForUpdatesCommand}"
                              IsEnabled="{Binding !IsCheckingUpdates}" />
                    <MenuItem Header="打开程序更新页" Command="{Binding OpenUpdatePageCommand}" />
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <Border Classes="chip" HorizontalAlignment="Left" MaxWidth="720">
            <TextBlock Text="{Binding PackPathDisplay}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Border Classes="accentChip" VerticalAlignment="Center">
              <TextBlock Text="{Binding ProfileSummary}" FontSize="11" />
            </Border>
            <Border Classes="chip" VerticalAlignment="Center">
              <TextBlock Text="{Binding CountSummary}" FontSize="11" />
            </Border>
            <Border Classes="chip" IsVisible="{Binding IsOffline}">
              <TextBlock Text="离线模式" FontSize="11" Foreground="{DynamicResource Warning}" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- ============================ Main content ============================ -->
    <Grid Grid.Row="1">
      <Grid x:Name="MainContentGrid" IsVisible="{Binding IsModsPage}" Margin="10,10,10,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" MinWidth="180" MaxWidth="360" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="310" MinWidth="230" MaxWidth="440" />
      </Grid.ColumnDefinitions>

      <!-- Left: search + filters + issue/mod navigator -->
      <Border Grid.Column="0" x:Name="LeftPanelBorder" Classes="card" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="筛选与问题" Classes="section" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Content="重置" Command="{Binding ResetFiltersCommand}"
                      FontSize="9.5" Padding="7,1" MinHeight="22"
                      ToolTip.Tip="清除搜索、状态、加载器与关系筛选" />
              <Button Content="«" Click="ToggleLeftPanel_Click"
                      FontSize="11" Padding="6,1" MinHeight="22"
                      ToolTip.Tip="收起左栏" />
            </StackPanel>
          </Grid>

          <TextBox Grid.Row="1" x:Name="SearchBox"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   Watermark="搜索名称 / modId / slug（Ctrl+F）"
                   FontSize="11"
                   ToolTip.Tip="空格分隔多个条件；前缀 - 或 ! 表示排除" />

          <TabControl Grid.Row="2">
            <TabItem Header="筛选">
              <ScrollViewer x:Name="FilterScrollViewer" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <StackPanel Spacing="10">
                  <Border Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                          BorderThickness="0,0,0,1" Padding="0,0,0,9">
                    <StackPanel Spacing="6">
                      <TextBlock Text="关系类型" Classes="section" />
                      <WrapPanel>
                        <CheckBox Content="必需" IsChecked="{Binding ShowRequires, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="可选" IsChecked="{Binding ShowOptional, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="推荐" IsChecked="{Binding ShowRecommends, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="不兼容" IsChecked="{Binding ShowIncompatible, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="手动" IsChecked="{Binding ShowManual, Mode=TwoWay}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                          BorderThickness="0,0,0,1" Padding="0,0,0,9">
                    <StackPanel Spacing="6">
                      <TextBlock Text="加载器" Classes="section" IsVisible="{Binding ShowLoaderFilters}" />
                      <WrapPanel IsVisible="{Binding ShowLoaderFilters}">
                        <CheckBox Content="Fabric" IsChecked="{Binding ShowFabric, Mode=TwoWay}"
                                  IsVisible="{Binding ShowFabricFilter}" Margin="0,0,12,0" />
                        <CheckBox Content="Quilt" IsChecked="{Binding ShowQuilt, Mode=TwoWay}"
                                  IsVisible="{Binding ShowQuiltFilter}" Margin="0,0,12,0" />
                        <CheckBox Content="Forge" IsChecked="{Binding ShowForge, Mode=TwoWay}"
                                  IsVisible="{Binding ShowForgeFilter}" Margin="0,0,12,0" />
                        <CheckBox Content="NeoForge" IsChecked="{Binding ShowNeoForge, Mode=TwoWay}"
                                  IsVisible="{Binding ShowNeoForgeFilter}" Margin="0,0,12,0" />
                        <CheckBox Content="未知" IsChecked="{Binding ShowUnknown, Mode=TwoWay}"
                                  IsVisible="{Binding ShowUnknownFilter}" />
                      </WrapPanel>
                      <Grid ColumnDefinitions="64,*" ColumnSpacing="8" Margin="0,3,0,0">
                        <TextBlock Text="侧" Classes="caption" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SideFilters}"
                                  SelectedItem="{Binding SelectedSideFilter, Mode=TwoWay}"
                                  FontSize="10.5" Height="28" HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SideFilterOption">
                              <TextBlock Text="{Binding Label}" FontSize="10.5" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <ComboBox ItemsSource="{Binding StatusFilters}"
                                SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                FontSize="10.5" Height="28" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatusFilterOption">
                            <TextBlock Text="{Binding Label}" FontSize="10.5" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <Expander Header="显示选项" IsExpanded="False" FontSize="10" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="5" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                        <CheckBox Content="只看问题" FontSize="10.5" IsChecked="{Binding OnlyProblems, Mode=TwoWay}" />
                        <CheckBox Grid.Column="1" Content="隐藏孤立" FontSize="10.5"
                                  IsChecked="{Binding HideIsolated, Mode=TwoWay}" />
                        <CheckBox Grid.Row="1" Content="展开内嵌" FontSize="10.5"
                                  IsChecked="{Binding ShowEmbedded, Mode=TwoWay}"
                                  ToolTip.Tip="展开父模组下所有内嵌 JAR" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="未安装可选" FontSize="10.5"
                                  IsChecked="{Binding ShowUninstalledOptional, Mode=TwoWay}" />
                        <CheckBox Grid.Row="2" Content="显示缺失" FontSize="10.5"
                                  IsChecked="{Binding ShowMissing, Mode=TwoWay}" />
                        <CheckBox Grid.Row="3" Content="可更新" FontSize="10.5"
                                  IsChecked="{Binding OnlyUpdatable, Mode=TwoWay}"
                                  IsEnabled="{Binding HasUpdateCheck}" />
                        <Button Grid.Row="3" Grid.Column="1" Content="检查模组更新"
                                Command="{Binding CheckUpdatesCommand}"
                                IsVisible="{Binding !IsCheckingUpdates}"
                                IsEnabled="{Binding !IsBusy}" FontSize="9.5" Padding="7,1" MinHeight="24" />
                      </Grid>
                      <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="6" IsVisible="{Binding IsListView}">
                        <TextBlock Text="依赖线" Classes="caption" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionLineOptions}"
                                  SelectedItem="{Binding SelectedConnectionLineMode, Mode=TwoWay}"
                                  FontSize="10.5" Height="28" HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionLineOption">
                              <TextBlock Text="{Binding Label}" FontSize="10.5" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" x:Name="RailManagerButton" Content="管理"
                                Click="RailManager_Click" FontSize="9.5" Padding="6,1" MinHeight="28"
                                ToolTip.Tip="隐藏 / 仅显示 / 恢复依赖线" />
                      </Grid>
                    </StackPanel>
                  </Expander>

                  <Expander Header="功能分类" IsExpanded="False" FontSize="10" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding CategoryChips}" Margin="0,4,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChipItem">
                          <Button Classes="categoryChip" Classes.active="{Binding IsActive}"
                                  Content="{Binding Display}" Command="{Binding SelectCommand}"
                                  Margin="0,0,4,4" ToolTip.Tip="按功能分类筛选" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="问题">
              <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="问题速览" Classes="section" IsVisible="{Binding IsListView}" />
                  <TextBlock Text="问题节点" Classes="section" IsVisible="{Binding IsGraphView}" />
                  <TextBlock Text="{Binding ProblemSummary}" FontSize="10"
                             Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                             IsVisible="{Binding IsListView}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Issues}"
                         SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                         IsVisible="{Binding IsListView}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IssueItemViewModel">
                      <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Message}" Margin="0,2">
                        <Border Width="3" CornerRadius="2" Background="{Binding SeverityBrush}" Margin="0,1,7,1" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Message}" FontSize="10.5"
                                     Foreground="{DynamicResource TextSecondary}"
                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Location}" FontSize="10"
                                     Foreground="{DynamicResource TextMuted}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <ListBox Grid.Row="1" ItemsSource="{Binding NodeItems}"
                         SelectedItem="{Binding SelectedNodeItem, Mode=TwoWay}"
                         IsVisible="{Binding IsGraphView}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeItemViewModel">
                      <Grid ColumnDefinitions="Auto,34,*,Auto" ColumnSpacing="2" ToolTip.Tip="{Binding Tooltip}">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center" MinWidth="0" Margin="0,0,2,0" />
                        <Grid Grid.Column="1" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,7,0">
                          <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource PanelAlt}"
                                  ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid>
                              <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                         Foreground="{Binding AvatarBrush}" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                              <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                            </Grid>
                          </Border>
                          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Stroke="{DynamicResource PanelBackground}" StrokeThickness="1.5" />
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                     Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Classes="chip" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                          <TextBlock Text="{Binding LoaderText}" FontSize="10.5" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" x:Name="LeftPanelSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- Center: structured mod list (default) or dependency graph -->
      <Border Grid.Column="2" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                  BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center"
                    ToolTip.Tip="单击查看详情 · 双击定位 · 右键快捷连接">
                <TextBlock Text="模组清单" FontWeight="SemiBold" FontSize="12.5" IsVisible="{Binding IsListView}" />
                <TextBlock Text="依赖图" FontWeight="SemiBold" FontSize="12.5" IsVisible="{Binding IsGraphView}" />
                <Grid Grid.Column="1">
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRelationFocus}"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding RelationFocusTitle}" FontSize="10.5"
                               Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"
                               MaxWidth="260" VerticalAlignment="Center" />
                    <Button Content="显示全部" Command="{Binding ClearRelationFocusCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="22" />
                  </StackPanel>
                </Grid>
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          IsVisible="{Binding IsListView}" Width="96" Height="30" FontSize="10.5"
                          ToolTip.Tip="排序方式">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModSortOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{Binding SortDirectionText}" Command="{Binding ToggleSortDirectionCommand}"
                        IsVisible="{Binding IsListView}" FontSize="11" Width="34" Padding="0,3" MinHeight="28"
                        ToolTip.Tip="{Binding SortDirectionTooltip}" />
                <ComboBox ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding SelectedViewOption, Mode=TwoWay}"
                          Width="92" Height="30" FontSize="10.5" ToolTip.Tip="切换模组清单 / 依赖图">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ViewOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="简化连线" IsChecked="{Binding FocusEdgesOnly, Mode=TwoWay}"
                          IsVisible="{Binding IsGraphView}" FontSize="10" VerticalAlignment="Center"
                          ToolTip.Tip="折叠库/前置节点的密集入线，选中或悬停时展开相关连线" />
                <ComboBox ItemsSource="{Binding GroupModes}"
                          SelectedItem="{Binding SelectedGroupMode, Mode=TwoWay}"
                          Width="96" Height="30" FontSize="10.5"
                          ToolTip.Tip="按分类 / 加载器 / 状态 / 侧分组">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupModeOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <!-- Structured mod list -->
            <Grid IsVisible="{Binding IsListView}" RowDefinitions="Auto,Auto,*,Auto,Auto" Background="{DynamicResource GraphBackground}">
              <Border Grid.Row="0" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
                      BorderThickness="0,0,0,1" Padding="12,6">
                <StackPanel Spacing="4">
                <Grid ColumnDefinitions="26,36,46,48,*,100,96,110,66,96">
                  <TextBlock Text="选" Grid.Column="0" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="#" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="模组" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="加载器" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="版本" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="7" Text="依赖关系" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="8" Text="侧" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="9" Text="状态" Classes="section" VerticalAlignment="Center" />
                </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Row="1" IsVisible="{Binding HasChecked}"
                      Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
                      BorderThickness="0,0,0,1" Padding="10,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Text="{Binding CheckedCount, StringFormat='已选 {0} 个'}"
                             FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="全选" Command="{Binding SelectAllVisibleCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                    <Button Content="清除" Command="{Binding ClearCheckedCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                    <Button Content="下载" Command="{Binding BatchDownloadCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                    <Button Content="升级" Command="{Binding BatchUpgradeCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                    <Button Content="禁用" Command="{Binding BatchDisableCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                    <Button Content="删除" Classes="danger" Command="{Binding BatchDeleteCommand}"
                            FontSize="9.5" Padding="6,1" MinHeight="23" Margin="3,0" />
                  </WrapPanel>
                </Grid>
              </Border>

              <ListBox Grid.Row="2" x:Name="ModuleList" Classes="dense" ItemsSource="{Binding NodeItems}"
                       SelectedItem="{Binding SelectedNodeItem, Mode=TwoWay}"
                       DoubleTapped="ModuleList_DoubleTapped"
                       Background="Transparent">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="1" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:NodeItemViewModel">
                    <StackPanel>
                    <TextBlock Text="{Binding GroupHeader}" IsVisible="{Binding HasGroupHeader}"
                               FontSize="9.5" FontWeight="SemiBold" Margin="42,7,0,2"
                               Foreground="{DynamicResource Accent}" />
                    <Grid ColumnDefinitions="26,36,46,48,*,100,96,110,66,96" ToolTip.Tip="{Binding Tooltip}">

                      <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                MinWidth="0" Margin="0,0,2,0" />
                      <TextBlock Grid.Column="1" Text="{Binding IndexText}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                 VerticalAlignment="Center" />
                      <Grid Grid.Column="3" Width="44" Height="44" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="7" Background="{DynamicResource PanelAlt}"
                                ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding AvatarBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}" />
                          </Grid>
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom" Margin="0,0,1,1"
                                 Stroke="{DynamicResource GraphBackground}" StrokeThickness="2" />
                      </Grid>
                      <StackPanel Grid.Column="4" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="{Binding EmbeddedToggleText}" Command="{Binding ToggleEmbeddedCommand}"
                                IsVisible="{Binding HasEmbeddedChildren}" FontSize="9.5" Padding="4,0"
                                MinHeight="20" HorizontalAlignment="Left" Margin="0,1,0,0"
                                ToolTip.Tip="展开 / 收起这个模组内嵌的 JAR" />
                      </StackPanel>
                      <Border Grid.Column="5" Classes="chip" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LoaderText}" FontSize="10.5" />
                      </Border>
                      <TextBlock Grid.Column="6" Text="{Binding Version}" FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="7" Text="{Binding DependencySummary}" FontSize="10.5"
                                 Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="8" Classes="chip" Padding="5,1" HorizontalAlignment="Left"
                              VerticalAlignment="Center" ToolTip.Tip="{Binding SideTooltip}">
                        <TextBlock Text="{Binding SideText}" FontSize="9.5" Foreground="{Binding SideBrush}" />
                      </Border>
                      <StackPanel Grid.Column="9" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="可选已装" FontSize="9.5"
                                   Foreground="{DynamicResource TextMuted}"
                                   IsVisible="{Binding IsInstalledOptionalDependency}" />
                        <TextBlock Text="{Binding IssueBadgeText}" FontSize="10.5"
                                   Foreground="{DynamicResource Warning}"
                                   IsVisible="{Binding HasIssueBadge}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="9.5"
                                   Foreground="{DynamicResource Success}"
                                   IsVisible="{Binding HasUpdateBadge}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding EmbeddedChildren}"
                                  IsVisible="{Binding IsEmbeddedExpanded}"
                                  Margin="108,0,0,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NodeItemViewModel">
                          <Button Classes="embeddedChild" Click="EmbeddedItem_Click"
                                  ToolTip.Tip="{Binding Tooltip}">
                            <Grid ColumnDefinitions="28,*,80,66,100" ColumnSpacing="7">
                              <Grid Width="24" Height="24" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="4"
                                        Background="{DynamicResource PanelAlt}" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding AvatarBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                                  </Grid>
                                </Border>
                              </Grid>
                              <StackPanel Grid.Column="1" Spacing="0">
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="10"
                                         Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="3" Classes="chip" Padding="4,1"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding SideTooltip}">
                                <TextBlock Text="{Binding SideText}" FontSize="9" Foreground="{Binding SideBrush}" />
                              </Border>
                              <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="10"
                                         Foreground="{Binding StatusTextBrush}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Canvas Grid.Row="2" x:Name="DependencyRailOverlay"
                      IsHitTestVisible="False" ClipToBounds="True" />

              <Border Grid.Row="3" IsVisible="{Binding ShowMissingSection}"
                      Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
                      BorderThickness="0,1,0,0" Padding="10,5,10,6">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="未安装的必需依赖" Classes="section" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding MissingNodeItems.Count, StringFormat='缺失 {0}'}"
                                 FontSize="10" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                      <Button Content="{Binding MissingToggleText}" Command="{Binding ToggleMissingSectionCommand}"
                              FontSize="9" Padding="6,1" MinHeight="22" />
                    </StackPanel>
                  </Grid>
                  <ListBox Grid.Row="1" x:Name="MissingList" ItemsSource="{Binding MissingNodeItems}" MaxHeight="140"
                           Background="Transparent" IsVisible="{Binding IsMissingSectionExpanded}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NodeItemViewModel">
                        <Border Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource Danger}" BorderThickness="2,0,0,0"
                                CornerRadius="4" Padding="6,3" Margin="0,1">
                          <Grid ColumnDefinitions="*,Auto,Auto,74" ColumnSpacing="6">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                         Foreground="{DynamicResource TextMuted}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="缺失依赖" FontSize="10"
                                       Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="忽略" Click="IgnoreMissing_Click"
                                    FontSize="10" Padding="4,2" MinHeight="24"
                                    ToolTip.Tip="添加本地规则，不再提示这个缺失依赖" />
                            <Button Grid.Column="3" Content="下载" Click="OptionalDownload_Click"
                                    FontSize="10" Padding="4,2" MinHeight="24"
                                    ToolTip.Tip="直接下载这个缺失依赖" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Row="4" IsVisible="{Binding ShowOptionalSection}"
                      Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
                      BorderThickness="1,0,0,0" Padding="10,5,10,6">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="可选依赖（未安装）" Classes="section" />
                    <TextBlock Grid.Column="1" Text="{Binding OptionalNodeItems.Count, StringFormat='可选 {0}'}"
                               FontSize="10" Foreground="{DynamicResource TextMuted}" />
                  </Grid>
                  <ListBox Grid.Row="1" x:Name="OptionalList" ItemsSource="{Binding OptionalNodeItems}" MaxHeight="180"
                           Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NodeItemViewModel">
                        <Grid ColumnDefinitions="*,Auto,74" ColumnSpacing="8" Margin="0,1">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="可选未安装" FontSize="10"
                                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Content="下载" Click="OptionalDownload_Click"
                                  FontSize="10" Padding="4,2" MinHeight="24"
                                  ToolTip.Tip="直接下载这个可选依赖" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>

            <!-- Graph canvas -->
            <Grid IsVisible="{Binding IsGraphView}">
              <controls:DependencyGraphView x:Name="GraphView"
                                            Scene="{Binding Scene}"
                                            Background="{DynamicResource GraphBackground}" />

              <!-- Legend -->
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="4">
                <Button x:Name="LegendToggleButton" Content="图例 ▾" Click="ToggleLegend_Click"
                        HorizontalAlignment="Right" FontSize="9.5" Padding="8,2" MinHeight="24"
                        ToolTip.Tip="展开 / 收起图例" />
                <Border x:Name="LegendPanel" Background="{DynamicResource PanelBackground}" Opacity="0.94"
                        CornerRadius="9" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        Padding="10,8" HorizontalAlignment="Right">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="20" Height="2" Background="#3B82F6" VerticalAlignment="Center" />
                    <TextBlock Text="必需" FontSize="10.5" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="20" Height="2" Background="#F87171" VerticalAlignment="Center" />
                    <TextBlock Text="不兼容" FontSize="10.5" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="20" Height="2" Background="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text="可选 / 推荐（虚线）" FontSize="10.5" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="20" Height="2" Background="#F5C542" VerticalAlignment="Center" />
                    <TextBlock Text="手动关系" FontSize="10.5" />
                  </StackPanel>
                  <TextBlock Text="滚轮缩放 · 拖拽平移 · Shift+拖拽框选" FontSize="10.5" Classes="caption" Margin="0,3,0,0" />
                  <TextBlock Text="简化连线：点击/悬停节点显示相关边" FontSize="9.5"
                             Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="190" />
                </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                          Orientation="Horizontal" Spacing="6">
                <Button Classes="icon" Content="−" Click="ZoomOut_Click" ToolTip.Tip="缩小" />
                <Button Classes="icon" Content="+" Click="ZoomIn_Click" ToolTip.Tip="放大" />
                <Button Classes="icon" Content="⤢" Click="Fit_Click" ToolTip.Tip="适应窗口" />
              </StackPanel>
            </Grid>

            <!-- Shared empty state -->
            <Border IsVisible="{Binding !HasGraph}" Background="{DynamicResource OverlayScrim}" CornerRadius="12">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="380" Margin="24">
                <Image Source="avares://PackDependencyTool/Assets/app.png" Width="56" Height="56" Opacity="0.9" />
                <TextBlock Text="还没有依赖数据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           IsVisible="{Binding !IsPackLoaded}" />
                <TextBlock Text="当前筛选没有匹配的模组" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           IsVisible="{Binding IsPackLoaded}" />
                <TextBlock Text="在「实例管理」中打开整合包，或直接把文件夹拖进窗口。"
                           Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="{Binding !IsPackLoaded}" />
                <TextBlock Text="试试放宽状态/加载器/关系筛选，或清空搜索内容。"
                           Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="{Binding IsPackLoaded}" />
                <Button Classes="accent" Content="打开整合包 / 实例…" Command="{Binding OpenInstancesCommand}"
                        HorizontalAlignment="Center" Margin="0,4,0,0" IsVisible="{Binding !IsPackLoaded}" />
                <Button Content="重置筛选" Command="{Binding ResetFiltersCommand}"
                        HorizontalAlignment="Center" Margin="0,4,0,0" IsVisible="{Binding IsPackLoaded}" />
              </StackPanel>
            </Border>

            <!-- Busy overlay -->
            <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource OverlayScrim}" CornerRadius="12">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Width="300">
                <TextBlock Text="正在处理…" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{Binding ProgressText}" Classes="caption"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" x:Name="RightPanelSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- Right: details / report / manual links -->
      <Border Grid.Column="4" x:Name="RightPanelBorder" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                  BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="详情面板" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="»" Click="ToggleRightPanel_Click"
                      FontSize="11" Padding="6,1" MinHeight="22"
                      ToolTip.Tip="收起右栏（可从顶部「面板」恢复）" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" IsVisible="{Binding !HasSelection}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" Margin="20">
            <TextBlock Text="尚未选择模组" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="从中间列表点选一个模组，这里会显示依赖、状态和操作。"
                       Classes="caption" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelection}"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TabControl>
          <TabItem Header="详情">
            <Grid RowDefinitions="*,Auto" Margin="10,8,10,8" RowSpacing="8">
              <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="9">
                  <!-- Mod header -->
                  <Border Classes="detailCard">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                              ClipToBounds="True" VerticalAlignment="Top"
                              IsVisible="{Binding IsNodeSelected}">
                        <Grid>
                          <TextBlock Text="{Binding DetailInitial}" FontSize="22" FontWeight="SemiBold"
                                     Foreground="{Binding DetailAvatarBrush}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" IsVisible="{Binding !HasDetailIcon}" />
                          <Image Source="{Binding DetailIcon}" Stretch="UniformToFill" IsVisible="{Binding HasDetailIcon}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailSubtitle}" FontSize="10.5" Classes="caption"
                                   TextWrapping="Wrap" />
                        <WrapPanel IsVisible="{Binding !HasSelection}" Margin="0,2,0,0">
                          <Button Content="打开整合包目录" Command="{Binding OpenPackFolderCommand}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" Margin="0,0,6,0" />
                          <Button Content="重新扫描" Command="{Binding RescanCommand}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" />
                        </WrapPanel>
                        <Border Classes="chip" HorizontalAlignment="Left" Padding="6,1"
                                IsVisible="{Binding HasRepairAdvice}">
                          <TextBlock Text="{Binding RepairAdviceText}" FontSize="9"
                                     Foreground="{Binding RepairAdviceBrush}" TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel IsVisible="{Binding IsNodeSelected}" Margin="0,3,0,0">
                          <Button Content="{Binding DownloadSelectedLabel}" Command="{Binding DownloadSelectedModCommand}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" Margin="0,0,5,4" />
                          <Button Content="禁用" Command="{Binding DisableSelectedModCommand}"
                                  IsVisible="{Binding CanDisableSelected}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" Margin="0,0,5,4" />
                          <Button Content="删除" Classes="danger" Command="{Binding DeleteSelectedModCommand}"
                                  IsVisible="{Binding CanDeleteSelected}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" Margin="0,0,5,4" />
                          <Button Content="定位 JAR" Command="{Binding OpenSelectedFileCommand}"
                                  IsVisible="{Binding CanOpenFile}"
                                  FontSize="9.5" Padding="7,2" MinHeight="24" Margin="0,0,5,4" />
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0">
                          <Border Classes="chip" Padding="6,1" Margin="0,0,5,0">
                            <TextBlock Text="模组详情" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Basic information -->
                  <Border Classes="detailCard">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="基本信息" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding BasicInfoToggleText}"
                                Command="{Binding ToggleBasicInfoCommand}"
                                FontSize="9" Padding="0" MinHeight="22" Width="42"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding DetailRows}"
                                    IsVisible="{Binding IsBasicInfoExpanded}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DetailRowViewModel">
                            <Grid ColumnDefinitions="76,*" Margin="0,0,0,5">
                              <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Top" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- Description -->
                  <Border Classes="detailCard" IsVisible="{Binding HasDetailDescription}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="简介" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding DescriptionToggleText}"
                                Command="{Binding ToggleDescriptionCommand}"
                                FontSize="9" Padding="0" MinHeight="22" Width="42"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" FontSize="11.5"
                                 Foreground="{DynamicResource TextSecondary}"
                                 IsVisible="{Binding IsDescriptionExpanded}" />
                    </StackPanel>
                  </Border>

                  <!-- Dependency relations -->
                  <Border IsVisible="{Binding HasDependencyRows}" BorderBrush="{DynamicResource CardBorder}"
                          BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="依赖关系" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondary}" />
                          <TextBlock Text="{Binding DependencyStatusSummary}" FontSize="9"
                                     Foreground="{DynamicResource TextMuted}"
                                     IsVisible="{Binding HasDependencyStatus}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding DependentsText}"
                                Command="{Binding FocusDependentsCommand}"
                                IsVisible="{Binding HasDependents}"
                                FontSize="9" Padding="5,1" MinHeight="22"
                                ToolTip.Tip="只看依赖它的已安装模组" />
                        <Button Grid.Column="2" Content="{Binding DependenciesToggleText}"
                                Command="{Binding ToggleDependenciesCommand}"
                                FontSize="9" Padding="0" MinHeight="22" Width="42"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding SelectedDependencyGroups}" Margin="0,4,0,0"
                                    IsVisible="{Binding IsDependenciesExpanded}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DependencyGroupViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,7">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="9.5"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:DependencyRowViewModel">
                                    <Border Classes="depRow" ToolTip.Tip="{Binding TargetId}"
                                            BorderBrush="{Binding TypeBrush}" BorderThickness="2,0,0,0"
                                            CornerRadius="0" Background="Transparent">
                                      <Grid ColumnDefinitions="16,*,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding DirectionText}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Border BorderBrush="{Binding TypeBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding TypeText}" FontSize="10" FontWeight="SemiBold"
                                                         Foreground="{Binding TypeBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding TargetName}" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                          </Grid>
                                          <TextBlock Text="{Binding RangeText}" FontSize="10"
                                                     Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Text="{Binding Note}" FontSize="9.5"
                                                     Foreground="{DynamicResource TextMuted}"
                                                     TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ResultText}" FontSize="10"
                                                   Foreground="{Binding ResultBrush}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="78" />
                                        <Button Grid.Column="3" Classes="icon" Content="⌖" FontSize="13"
                                                Padding="4,0" MinHeight="24"
                                                IsVisible="{Binding CanLocate}"
                                                Click="DependencyLocate_Click"
                                                ToolTip.Tip="定位到模组列表" />
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- Actions fixed at bottom -->
              <Border Grid.Row="1" Background="{DynamicResource PanelBackground}"
                      BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                      CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*"
                      RowSpacing="4" ColumnSpacing="6">
                  <Button Grid.Row="0" Grid.Column="0" Content="添加关系" Command="{Binding AddManualLinkCommand}"
                          IsVisible="{Binding CanAddRelation}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="0" Grid.Column="1" Content="编辑手动关系" Command="{Binding EditManualLinkCommand}"
                          IsVisible="{Binding CanEditManual}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="0" Grid.Column="2" Classes="danger" Content="删除手动关系"
                          Command="{Binding DeleteManualLinkCommand}"
                          IsVisible="{Binding CanDeleteManual}" HorizontalAlignment="Stretch" />

                  <Button Grid.Row="1" Grid.Column="0" Content="复制 modId" Command="{Binding CopySelectedIdCommand}"
                          IsVisible="{Binding IsNodeSelected}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="1" Grid.Column="1" Content="在依赖图中查看"
                          Command="{Binding ShowInGraphCommand}"
                          IsVisible="{Binding IsNodeSelected}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="1" Grid.Column="2" Content="只看相关关系"
                          Command="{Binding FocusSelectedRelationsCommand}"
                          IsVisible="{Binding IsNodeSelected}" HorizontalAlignment="Stretch" />

                  <Button Grid.Row="2" Grid.Column="0" Content="设置中文名"
                          Command="{Binding EditChineseNameCommand}"
                          IsVisible="{Binding IsNodeSelected}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="2" Grid.Column="1" Content="{Binding DownloadSelectedLabel}"
                          Command="{Binding DownloadSelectedModCommand}"
                          IsVisible="{Binding IsNodeSelected}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="2" Grid.Column="2" Content="禁用模组"
                          Command="{Binding DisableSelectedModCommand}"
                          IsVisible="{Binding CanDisableSelected}" HorizontalAlignment="Stretch" />

                  <Button Grid.Row="3" Grid.Column="0" Classes="danger" Content="永久删除"
                          Command="{Binding DeleteSelectedModCommand}"
                          IsVisible="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="3" Grid.Column="1" Content="定位 JAR" Command="{Binding OpenSelectedFileCommand}"
                          IsVisible="{Binding CanOpenFile}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="3" Grid.Column="2" Classes="accent" Content="下载可选依赖"
                          Command="{Binding DownloadOptionalDependencyCommand}"
                          IsVisible="{Binding CanDownloadOptional}" HorizontalAlignment="Stretch" />

                  <Button Grid.Row="4" Grid.Column="0" Content="CurseForge"
                          Command="{Binding OpenCurseForgeCommand}"
                          IsVisible="{Binding CanOpenCurseForge}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="4" Grid.Column="1" Content="Modrinth"
                          Command="{Binding OpenModrinthCommand}"
                          IsVisible="{Binding CanOpenModrinth}" HorizontalAlignment="Stretch" />
                  <Button Grid.Row="4" Grid.Column="2" Content="百科"
                          Command="{Binding OpenMcmodCommand}"
                          IsVisible="{Binding CanOpenMcmod}" HorizontalAlignment="Stretch" />
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="报告">
            <Grid RowDefinitions="Auto,*,Auto" Margin="14,10,14,12">
              <StackPanel Spacing="8">
                <WrapPanel>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Danger}"
                               Text="{Binding MissingCount, StringFormat='缺失 {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Warning}"
                               Text="{Binding MismatchCount, StringFormat='版本 {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Danger}"
                               Text="{Binding ConflictCount, StringFormat='冲突 {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock FontSize="11" Text="{Binding ErrorCount, StringFormat='错误 {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <TextBlock FontSize="11" Text="{Binding WarningCount, StringFormat='警告 {0}'}" />
                  </Border>
                  <CheckBox Content="包含可选依赖" FontSize="10.5"
                            IsChecked="{Binding ShowOptionalInReport, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Text="{Binding IssueSummary}" Classes="caption" />
              </StackPanel>

              <ListBox Grid.Row="1" ItemsSource="{Binding ReportIssues}"
                       SelectedItem="{Binding SelectedIssue, Mode=TwoWay}" Margin="0,10,0,10">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:IssueItemViewModel">
                    <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Message}">
                      <Border Width="3" CornerRadius="2" Background="{Binding SeverityBrush}" Margin="0,1,8,1" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button Grid.Row="2" Content="导出 Markdown 报告"
                      Command="{Binding ExportReportCommand}" HorizontalAlignment="Stretch" />
            </Grid>
          </TabItem>

          <TabItem Header="手动关系">
            <Grid RowDefinitions="*,Auto" Margin="14,10,14,12">
              <ListBox ItemsSource="{Binding ManualLinks}"
                       SelectedItem="{Binding SelectedManualLink, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ManualLinkItemViewModel">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding PairText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" FontSize="10.5" Classes="caption"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
                <WrapPanel>
                  <Button Content="新增" Command="{Binding AddManualLinkCommand}" Margin="0,0,6,6" />
                  <Button Content="编辑" Command="{Binding EditManualLinkCommand}" Margin="0,0,6,6" />
                  <Button Classes="danger" Content="删除" Command="{Binding DeleteManualLinkCommand}" Margin="0,0,6,6" />
                </WrapPanel>
                <WrapPanel>
                  <Button Content="导入" Command="{Binding ImportManualLinksCommand}" Margin="0,0,6,0" />
                  <Button Content="导出" Command="{Binding ExportManualLinksCommand}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="规则">
            <Grid RowDefinitions="Auto,*,Auto" Margin="14,10,14,12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding RulesSummary}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="按优先级从高到低匹配。关闭开关即可临时停用；规则只影响分析，不修改 JAR。"
                           Classes="caption" TextWrapping="Wrap" />
              </StackPanel>

              <ListBox Grid.Row="1" ItemsSource="{Binding LocalRules}"
                       SelectedItem="{Binding SelectedLocalRule, Mode=TwoWay}" Margin="0,10,0,10">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalRuleItemViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top"
                                ToolTip.Tip="启用 / 停用这条规则" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <WrapPanel>
                          <TextBlock Text="{Binding TypeText}" FontSize="11.5" FontWeight="SemiBold" />
                          <Border Classes="chip" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding PriorityText, StringFormat='优先级 {0}'}" FontSize="10.5" />
                          </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Expression}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Spacing="6">
                <WrapPanel>
                  <Button Content="新增" Command="{Binding AddLocalRuleCommand}" Margin="0,0,6,6" />
                  <Button Content="编辑" Command="{Binding EditLocalRuleCommand}" Margin="0,0,6,6" />
                  <Button Classes="danger" Content="删除" Command="{Binding DeleteLocalRuleCommand}" Margin="0,0,6,6" />
                </WrapPanel>
                <WrapPanel>
                  <Button Content="导入规则" Command="{Binding ImportLocalRulesCommand}" Margin="0,0,6,0" />
                  <Button Content="导出规则" Command="{Binding ExportLocalRulesCommand}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="历史">
            <Grid RowDefinitions="Auto,*,Auto,Auto,*" Margin="14,10,14,12" RowSpacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="模组历史" FontWeight="SemiBold" FontSize="12.5" />
                  <TextBlock Text="每次扫描后记录新增、移除、版本变化与禁用/启用。"
                             Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="清空" Command="{Binding ClearHistoryCommand}"
                        FontSize="10.5" Padding="8,2" MinHeight="24" VerticalAlignment="Top" />
              </Grid>

              <ListBox Grid.Row="1" ItemsSource="{Binding HistoryEntries}"
                       SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                       MaxHeight="190">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntryItem">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                 Foreground="{DynamicResource TextMuted}" Width="72" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Grid.Row="2" Text="本次变更" Classes="section" />
              <ListBox Grid.Row="4" ItemsSource="{Binding HistoryChanges}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryChangeItem">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{Binding Brush}"
                                 Width="34" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5"
                                 Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Grid.Row="3" Text="选择一条历史查看细节" Classes="caption" />
            </Grid>
          </TabItem>
          </TabControl>
          </ScrollViewer>
        </Grid>
      </Border>
      </Grid>

      <Border IsVisible="{Binding IsDiagnosticsPage}" Margin="10,10,10,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Spacing="12" Margin="24,22,24,24">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
              <Border Classes="card" Padding="14,10" CornerRadius="9">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding MissingCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                  <TextBlock Text="缺失依赖" Classes="caption" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="14,10" CornerRadius="9">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding ConflictCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" />
                  <TextBlock Text="版本 / JAR 冲突" Classes="caption" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card" Padding="14,10" CornerRadius="9">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding ErrorCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                  <TextBlock Text="错误" Classes="caption" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="card" Padding="14,10" CornerRadius="9">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding InfoCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Text="提示" Classes="caption" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="日志与崩溃" Classes="section" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="10">
              <Border Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="崩溃日志诊断" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="读取 crash-report / latest.log / hs_err，抽取事实、证据、修复步骤和来源。" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="选择日志并诊断" Command="{Binding DiagnoseCrashCommand}" Classes="accent" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="JAR 冲突扫描" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="重复类、资源覆盖和 Mixin 目标重叠。" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="开始扫描" Command="{Binding ScanJarConflictsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="性能与定位" Classes="section" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="性能归因" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="解析 spark / 性能日志中的 TPS、MSPT 和热点。" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="分析性能" Command="{Binding AnalyzePerformanceCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="二分诊断" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="按依赖闭包分组，逐步缩小问题模组范围。" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="打开二分" Command="{Binding OpenBisectionCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="数据包扫描" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="检查 recipes / loot_tables / quests 的 JSON 和重复 ID。" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="扫描数据包" Command="{Binding ScanDataPacksCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="诊断只基于当前实例的日志和文件；没有匹配项时不会猜测。" Classes="caption" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border IsVisible="{Binding IsServerPage}" Margin="10,10,10,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Spacing="12" Margin="24,22,24,24">
            <Grid ColumnDefinitions="1.35*,*" ColumnSpacing="12">
              <Border Classes="card" Padding="18" CornerRadius="10">
                <StackPanel Spacing="8">
                  <TextBlock Text="服务端包" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CountSummary}" Classes="caption" />
                  <TextBlock Text="从当前实例筛选服务端可用模组，复制 config / defaultconfigs / scripts，并生成启动脚本与 zip。" Classes="caption" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,4,0,0">
                    <Button Content="打开服务端工具…" Command="{Binding OpenServerToolsCommand}" Classes="accent" FontSize="11" Padding="14,7" Margin="0,0,8,4" />
                    <Button Content="重新扫描实例" Command="{Binding RescanCommand}" FontSize="11" Padding="12,7" Margin="0,0,8,4" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="18" CornerRadius="10">
                <StackPanel Spacing="8">
                  <TextBlock Text="部署流程" Classes="section" />
                  <TextBlock Text="1. 扫描当前实例，确认客户端/服务端侧分类" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="2. 在服务端工具中取消客户端专用模组" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="3. 选择是否复制配置，生成服务端目录" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="4. 生成 start-server.bat 并打包 zip" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StatusText}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxHeight="34" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border IsVisible="{Binding IsHomePage}" Margin="10,10,10,6"
              Background="{DynamicResource AppBackground}">
        <Grid RowDefinitions="*,250">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Spacing="14" Margin="24,22,24,24">
            <StackPanel Spacing="6" IsVisible="{Binding !HasGraph}">
              <TextBlock Text="开始使用" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="选择一个整合包，先做体检，再进入模组列表处理问题。"
                         FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12" IsVisible="{Binding !HasGraph}">
              <Border Classes="card" Padding="20" CornerRadius="12">
                <StackPanel Spacing="9">
                  <TextBlock Text="① 打开整合包" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="选择包含 mods 文件夹的实例目录，或直接把文件夹拖进窗口。"
                             FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                  <Button Content="选择整合包…" Command="{Binding OpenInstancesCommand}"
                          Classes="accent" FontSize="12" Padding="16,8" MinHeight="36"
                          HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Padding="20" CornerRadius="12">
                <StackPanel Spacing="9">
                  <TextBlock Text="最近使用" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="选择后会自动扫描当前实例。" FontSize="11"
                             Foreground="{DynamicResource TextSecondary}" />
                  <ComboBox ItemsSource="{Binding RecentPacks}"
                            SelectedItem="{Binding SelectedRecentPack, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" Height="32" FontSize="11"
                            PlaceholderText="选择最近整合包">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12" IsVisible="{Binding HasGraph}">
              <Border Classes="card" Padding="18" CornerRadius="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="当前实例" Classes="section" />
                  <ComboBox ItemsSource="{Binding Instances}"
                            SelectedItem="{Binding SelectedHomeInstance, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" Height="32" FontSize="10.5"
                            PlaceholderText="选择实例">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="scanning:MinecraftInstanceInfo">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" FontSize="9"
                                     Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding PackName}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ProfileSummary}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{Binding PackPathDisplay}" FontSize="9.5"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}" />
                  <TextBlock Text="{Binding CountSummary}" Classes="caption" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="启动游戏" Command="{Binding LaunchCurrentInstanceCommand}"
                            IsEnabled="{Binding HasGraph}" Classes="accent"
                            FontSize="12" Padding="14,8" MinHeight="36" Margin="0,0,8,0" />
                    <Button Content="进入模组列表" Command="{Binding EnterWorkspaceCommand}"
                            FontSize="12" Padding="14,8" MinHeight="36" Margin="0,0,8,0" />
                    <Button Content="实例管理" Command="{Binding OpenInstancesCommand}"
                            FontSize="12" Padding="14,8" MinHeight="36" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="16" CornerRadius="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="健康概览" Classes="section" />
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Classes="card" Padding="10,7" CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="{Binding MissingCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}" />
                        <TextBlock Text="缺失依赖" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="10,7" CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="{Binding ConflictCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warning}" />
                        <TextBlock Text="冲突" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Padding="10,7" CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}" />
                        <TextBlock Text="错误" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="10,7" CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="{Binding InfoCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="提示" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Button Content="一键体检向导" Command="{Binding OpenHealthWizardCommand}"
                          FontSize="10.5" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12" IsVisible="{Binding HasGraph}">
              <Border Classes="card" Padding="16" CornerRadius="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="常用操作" Classes="section" />
                  <WrapPanel>
                    <Button Content="崩溃诊断" Command="{Binding DiagnoseCrashCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                    <Button Content="冲突扫描" Command="{Binding ScanJarConflictsCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                    <Button Content="服务端工具" Command="{Binding OpenServerToolsCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                    <Button Content="备份中心" Command="{Binding OpenBackupCenterCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                    <Button Content="对比历史" Command="{Binding CompareModListHistoryCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                    <Button Content="更新中心" Command="{Binding OpenUpdateCenterCommand}"
                            FontSize="11" Padding="12,7" Margin="0,0,7,7" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="16" CornerRadius="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="最近打开" Classes="section" />
                  <ComboBox ItemsSource="{Binding RecentPacks}"
                            SelectedItem="{Binding SelectedRecentPack, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" Height="32" FontSize="10.5"
                            PlaceholderText="选择最近整合包">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="10" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap"
                             MaxHeight="34" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card" Padding="12" CornerRadius="10" IsVisible="{Binding GameRunning}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Success}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="游戏运行中" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding GameRunningText}" FontSize="10.5"
                             Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <controls:RuntimeConsoleView Grid.Row="1" DataContext="{Binding RuntimeConsole}" />
        </Grid>
      </Border>

    </Grid>

    <!-- ============================ Status bar ============================ -->
    <Border Grid.Row="2"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="0,1,0,0"
            Padding="16,7">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="640" />
        </StackPanel>

        <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Value="{Binding ProgressValue}" Maximum="1" IsVisible="{Binding IsBusy}"
                     VerticalAlignment="Center" Margin="8,0" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProgressText}" Classes="caption" IsVisible="{Binding IsBusy}" />
          <Button Content="检测到变化 · 重新扫描" Command="{Binding RescanCommand}"
                  IsVisible="{Binding HasFileChanges}" FontSize="9.5" Padding="7,1" MinHeight="22"
                  ToolTip.Tip="{Binding FileChangeText}" />
          <TextBlock Text="{Binding NetworkStatusText}" Classes="caption" />
          <TextBlock Text="{Binding VersionLabel}" Classes="caption" />
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
