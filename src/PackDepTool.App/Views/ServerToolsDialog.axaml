<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        x:Class="PackDepTool.App.Views.ServerToolsDialog"
        x:DataType="vm:ServerToolsViewModel"
        Title="服务端工具"
        Width="920"
        Height="680"
        MinWidth="780"
        MinHeight="540"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="3">
        <TextBlock Text="服务端工具" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="按客户端/服务端侧筛选模组，生成可复制的服务端包；不会启动服务端。"
                   Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
        <TextBlock Text="{Binding SummaryText}" FontSize="10.5" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="12">
      <Border Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="模组筛选" Classes="section" Margin="4,2,4,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerPackEntryItem">
                <Grid ColumnDefinitions="*,Auto" Margin="2,3">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FileName}" FontSize="9.5"
                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Reason}" FontSize="9"
                               Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SideText}" FontSize="9" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding StateText}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{Binding StateBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="启动前检查" Classes="section" />
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Content="刷新检查" Command="{Binding RefreshGateCommand}" FontSize="9.5"
                    Padding="7,2" MinHeight="26" />
            <Button Grid.Column="1" Content="选择 java.exe…" Command="{Binding PickJavaCommand}"
                    FontSize="9.5" Padding="7,2" MinHeight="26" HorizontalAlignment="Left" />
          </Grid>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding GateChecks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerGateItem">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Margin="0,2">
                  <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="SemiBold"
                             Foreground="{Binding StatusBrush}" Width="30" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" FontSize="9.5"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Fix}" FontSize="9"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Row="3" Spacing="5">
            <TextBlock Text="输出目录" Classes="caption" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding Destination, Mode=TwoWay}" Height="30" />
              <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseDestinationCommand}" Height="30" />
            </Grid>
            <CheckBox Content="复制 config / defaultconfigs / scripts"
                      IsChecked="{Binding IncludeConfigs, Mode=TwoWay}" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="{Binding StatusText}" Classes="caption"
                     TextWrapping="Wrap" VerticalAlignment="Bottom" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="未知侧模组会保留；客户端-only 模组会被排除。"
                 Classes="caption" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="关闭" Command="{Binding CloseCommand}" />
        <Button Content="生成服务端包" Classes="accent" Command="{Binding BuildCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
