<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PackDepTool.App.ViewModels"
             x:Class="PackDepTool.App.Views.DashboardPage"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource AppBackground}">
  <StackPanel Spacing="14" Margin="20,18,20,24">

      <Border Classes="card" Padding="18" IsVisible="{Binding !HasGraph}">
        <StackPanel Spacing="8">
          <TextBlock Text="还没有可分析的整合包" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="打开一个实例后，这里会显示模组、依赖、冲突和健康评分。"
                     Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
          <Button Content="打开实例…" Command="{Binding OpenInstancesCommand}" Classes="accent"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="14" IsVisible="{Binding HasGraph}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <StackPanel Spacing="2">
            <TextBlock Text="仪表盘" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PackName}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="重新扫描" Command="{Binding RescanCommand}" />
            <Button Content="一键体检" Command="{Binding OpenHealthWizardCommand}" Classes="accent" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="12">
          <Border Classes="card" Padding="18">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Spacing="0" VerticalAlignment="Center" Width="150">
                <TextBlock Text="健康评分" Classes="section" />
                <TextBlock Text="{Binding DashboardHealthScore}" FontSize="42" FontWeight="Bold"
                           Foreground="{Binding DashboardHealthBrush}" />
                <TextBlock Text="{Binding DashboardHealthLabel}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <UniformGrid Columns="2" Rows="2">
                  <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="缺失依赖" Classes="caption" />
                    <TextBlock Text="{Binding MissingCount}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Danger}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="冲突" Classes="caption" />
                    <TextBlock Text="{Binding ConflictCount}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Warning}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="版本不匹配" Classes="caption" />
                    <TextBlock Text="{Binding MismatchCount}" FontSize="20" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="关系总数" Classes="caption" />
                    <TextBlock Text="{Binding RelationCount}" FontSize="20" FontWeight="SemiBold" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="card" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="模组概览" Classes="section" />
              <TextBlock Text="{Binding InstalledModCount}" FontSize="30" FontWeight="Bold" />
              <TextBlock Text="已安装顶层模组" Classes="caption" />
              <WrapPanel Margin="0,8,0,0">
                <Button Content="进入模组列表" Command="{Binding EnterWorkspaceCommand}" />
                <Button Content="依赖图" Command="{Binding ShowDependencyGraphCommand}" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="12">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="依赖结构" Classes="section" />
                <TextBlock Grid.Column="1" Text="{Binding RelationCount, StringFormat='{}{0} 条关系'}"
                           Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding DashboardBars}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashboardBarItem">
                    <StackPanel Spacing="3" Margin="0,0,0,9">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="9.5"
                                   Foreground="{DynamicResource TextMuted}" />
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100" Height="7"
                                   Foreground="{Binding Brush}" Background="{DynamicResource PanelAlt}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="待处理问题" Classes="section" />
                <TextBlock Grid.Column="1" Text="按严重程度" Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding DashboardProblems}" IsVisible="{Binding HasDashboardProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashboardProblemItem">
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="9"
                                   Foreground="{Binding Brush}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="当前没有缺失、冲突或版本不匹配。" Classes="caption"
                         IsVisible="{Binding !HasDashboardProblems}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card" Padding="14">
          <WrapPanel>
            <Button Content="备份 config…" Command="{Binding OpenBackupCenterCommand}" Margin="0,0,8,0" />
            <Button Content="检查更新" Command="{Binding OpenDiscoverCommand}" Margin="0,0,8,0" />
            <Button Content="打开实例目录" Command="{Binding OpenPackFolderCommand}" Margin="0,0,8,0" />
            <Button Content="修复建议" Command="{Binding OpenHealthWizardCommand}" />
          </WrapPanel>
        </Border>
      </StackPanel>
    </StackPanel>
</UserControl>
