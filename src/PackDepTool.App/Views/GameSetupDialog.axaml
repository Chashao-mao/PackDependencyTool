<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackDepTool.App.ViewModels"
        xmlns:net="using:PackDepTool.Core.Net"
        x:Class="PackDepTool.App.Views.GameSetupDialog"
        x:DataType="vm:GameSetupViewModel"
        Title="下载游戏本体与加载器"
        Width="840"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
      <Border Width="42" Height="3" CornerRadius="2" Background="{DynamicResource Accent}"
              HorizontalAlignment="Left" Margin="0,0,0,7" />
      <TextBlock Text="下载游戏本体与加载器" Classes="title" FontSize="19" />
      <TextBlock Text="选择版本、加载器和实例名称；可复用已有游戏目录。此窗口只准备文件，不登录、不启动游戏。"
                 Classes="caption" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="12" Padding="16">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
        <TextBlock Text="实例保存目录" Classes="caption" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="32" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="浏览…" Command="{Binding BrowseTargetCommand}" Height="32" />
          <Button Content="扫描启动器目录" Command="{Binding ScanPclDirectoriesCommand}" Height="32" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="110,*" ColumnSpacing="8">
        <TextBlock Text="实例名称" Classes="caption" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" Watermark="留空自动命名，如 1.21.1-neoforge-21.1.264"
                 IsEnabled="{Binding !UseTargetAsInstance}" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Minecraft 版本" Classes="caption" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}"
                  SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" Height="32"
                  PlaceholderText="选择 Minecraft 版本">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="net:MinecraftVersionInfo">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Grid.Column="2" Content="仅正式版" IsChecked="{Binding OnlyReleases, Mode=TwoWay}"
                  VerticalAlignment="Center" />
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="110,*" ColumnSpacing="8">
        <TextBlock Text="加载器" Classes="caption" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Loaders}"
                  SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" Height="32"
                  PlaceholderText="选择加载器" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GameLoaderOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="110,*,150,Auto" ColumnSpacing="8">
        <TextBlock Text="加载器版本" Classes="caption" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderVersions}"
                  SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}" Height="32"
                  MaxDropDownHeight="320" PlaceholderText="选择加载器版本"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="net:LoaderVersionInfo">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="2" Text="{Binding LoaderVersionText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="32"
                 Watermark="手动版本" />
        <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshLoaderVersionsCommand}" Height="32" />
      </Grid>

      <Grid Grid.Row="5" ColumnDefinitions="110,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowJava}">
        <TextBlock Text="Java 路径" Classes="caption" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding JavaPath}" Height="32"
                 Watermark="Forge / NeoForge 安装器需要 java.exe" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="自动检测" Command="{Binding DetectJavaCommand}" Height="32" />
          <Button Content="浏览…" Command="{Binding BrowseJavaCommand}" Height="32" />
        </StackPanel>
      </Grid>

      <CheckBox Grid.Row="6" Content="同时下载 assets 资源文件（启动器可复用，避免启动时重复下载）"
                IsChecked="{Binding DownloadAssets, Mode=TwoWay}" />

      <CheckBox Grid.Row="7" Content="直接安装到所选目录（选现有游戏目录时可复用 libraries/assets，不再建子文件夹）"
                IsChecked="{Binding UseTargetAsInstance, Mode=TwoWay}" />

      <TextBlock Grid.Row="8" Text="提示：Fabric / Quilt 使用官方 meta；Forge / NeoForge 调用官方安装器（需要 Java 21）。启动器选择这个实例目录作为游戏目录即可读取 versions/libraries/assets。"
                 Classes="caption" TextWrapping="Wrap" />

      <StackPanel Grid.Row="9" Spacing="6">
        <ProgressBar IsVisible="{Binding IsBusy}" Value="{Binding ProgressValue}" Maximum="1" Height="5" />
        <TextBlock Text="{Binding StatusText}" FontSize="10.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />
        <TextBlock Text="{Binding ProgressText}" Classes="caption" IsVisible="{Binding IsBusy}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Text="本功能不包含账号登录、Java 下载或启动游戏；请用启动器启动已安装的环境。"
                 Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="取消安装" Command="{Binding CancelInstallCommand}"
                IsVisible="{Binding IsInstalling}" />
        <Button Content="关闭" Command="{Binding CancelCommand}"
                IsEnabled="{Binding !IsInstalling}" />
        <Button Content="{Binding InstallButtonText}" Classes="accent"
                Command="{Binding InstallCommand}" IsEnabled="{Binding !IsInstalling}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
