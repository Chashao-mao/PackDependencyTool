<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PackDepTool.App.ViewModels"
             x:Class="PackDepTool.App.Controls.RuntimeConsoleView"
             x:DataType="vm:RuntimeConsoleViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
    <Grid RowDefinitions="Auto,*" Margin="12,8,12,10">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="运行控制台" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LogStatus}" FontSize="9.5"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LevelSummary}" FontSize="9"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="折叠堆栈" Classes="consoleChip" Height="26"
                        IsChecked="{Binding CollapseStackTraces, Mode=TwoWay}" />
          <ToggleButton Content="自动滚动" Classes="consoleChip" Height="26"
                        IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
          <Button Content="分析日志" Command="{Binding AnalyzeCommand}" Height="26"
                  FontSize="9.5" Padding="7,2" />
          <Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" Height="26"
                  FontSize="9.5" Padding="7,2" />
          <Button Content="清空显示" Command="{Binding ClearLogCommand}" Height="26"
                  FontSize="9.5" Padding="7,2" />
        </StackPanel>
      </Grid>

      <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
        <TabItem Header="日志">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,5">
              <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="过滤日志内容 / 线程" FontSize="10" Height="26" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Content="全部" Classes="severity" Height="26" Classes.active="{Binding IsLevelAll}"
                        Command="{Binding SetLevelCommand}" CommandParameter="全部等级" />
                <Button Content="INFO" Classes="severity" Height="26" Classes.active="{Binding IsLevelInfo}"
                        Command="{Binding SetLevelCommand}" CommandParameter="INFO" />
                <Button Content="WARN" Classes="severity" Height="26" Classes.active="{Binding IsLevelWarn}"
                        Command="{Binding SetLevelCommand}" CommandParameter="WARN" />
                <Button Content="ERROR" Classes="severity" Height="26" Classes.active="{Binding IsLevelError}"
                        Command="{Binding SetLevelCommand}" CommandParameter="ERROR" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="64,52,*,150" ColumnSpacing="6"
                  Margin="6,0,6,2">
              <TextBlock Text="时间" FontSize="9" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="1" Text="级别" FontSize="9" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="2" Text="内容" FontSize="9" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="3" Text="线程" FontSize="9" Foreground="{DynamicResource TextMuted}"
                         HorizontalAlignment="Right" />
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelAlt}" CornerRadius="6" Padding="6">
              <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent"
                       BorderThickness="0"
                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="10">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConsoleLogLine">
                    <Border Background="{Binding RowBackground}" CornerRadius="3" Padding="2,1" Margin="0,1">
                      <Grid ColumnDefinitions="64,52,*,150" ColumnSpacing="6">
                        <TextBlock Text="{Binding Time}" FontSize="9.5" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="3"
                                Padding="4,1" VerticalAlignment="Top" IsVisible="{Binding HasLevel}">
                          <TextBlock Text="{Binding Level}" FontSize="8.5" FontWeight="SemiBold"
                                     Foreground="{Binding Brush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayMessage}" FontSize="10"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="3" Text="{Binding Thread}" FontSize="8.5"
                                   Foreground="{DynamicResource TextMuted}" MaxWidth="148"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="下载队列">
          <Grid RowDefinitions="Auto,*" Margin="0,4,0,0" RowSpacing="5">
            <TextBlock Text="{Binding QueueStatus}" FontSize="9.5"
                       Foreground="{DynamicResource TextSecondary}" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Downloads}" Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueItemViewModel">
                  <Border Background="{DynamicResource PanelAlt}" CornerRadius="6" Padding="8,5" Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding StateText}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                        <Button Content="暂停/继续" Command="{Binding PauseOrResumeCommand}"
                                FontSize="9" Padding="5,2" MinHeight="22" />
                        <Button Content="取消" Command="{Binding CancelCommand}"
                                FontSize="9" Padding="5,2" MinHeight="22" />
                      </StackPanel>
                      <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Progress}"
                                   Maximum="1" Height="4" Foreground="{Binding StateBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</UserControl>
