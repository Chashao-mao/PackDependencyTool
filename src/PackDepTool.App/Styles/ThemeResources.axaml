<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackground" Color="#0A0F17" />
      <Color x:Key="SystemAccentColor">#3B82F6</Color>
      <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
      <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
      <Color x:Key="SystemAccentColorDark3">#1E40AF</Color>
      <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
      <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
      <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="HeaderBackground" Color="#121B28" />
      <SolidColorBrush x:Key="PanelBackground" Color="#111A28" />
      <SolidColorBrush x:Key="PanelAlt" Color="#1A2638" />
      <SolidColorBrush x:Key="CardBorder" Color="#2A3A50" />
      <SolidColorBrush x:Key="TextPrimary" Color="#E9EFF8" />
      <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
      <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
      <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
      <SolidColorBrush x:Key="AccentHover" Color="#60A5FA" />
      <SolidColorBrush x:Key="AccentSoft" Color="#172A46" />
      <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Danger" Color="#E5534B" />
      <SolidColorBrush x:Key="Warning" Color="#F0A63C" />
      <SolidColorBrush x:Key="Success" Color="#34D399" />
      <SolidColorBrush x:Key="Gold" Color="#F5C542" />
      <SolidColorBrush x:Key="GraphBackground" Color="#0C131E" />
      <SolidColorBrush x:Key="GraphGrid" Color="#16202F" />
      <SolidColorBrush x:Key="NodeFill" Color="#17222F" />
      <SolidColorBrush x:Key="NodeBorder" Color="#2B3A4F" />
      <SolidColorBrush x:Key="ChipBackground" Color="#182232" />
      <SolidColorBrush x:Key="HoverOverlay" Color="#1E2A3A" />
      <SolidColorBrush x:Key="OverlayScrim" Color="#E60B111A" />
      <SolidColorBrush x:Key="RowAlt" Color="#0AFFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackground" Color="#F2F5F9" />
      <Color x:Key="SystemAccentColor">#0369A1</Color>
      <Color x:Key="SystemAccentColorDark1">#075985</Color>
      <Color x:Key="SystemAccentColorDark2">#0C4A6E</Color>
      <Color x:Key="SystemAccentColorDark3">#082F49</Color>
      <Color x:Key="SystemAccentColorLight1">#0284C7</Color>
      <Color x:Key="SystemAccentColorLight2">#38BDF8</Color>
      <Color x:Key="SystemAccentColorLight3">#BAE6FD</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0369A1" />
      <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelAlt" Color="#F4F7FA" />
      <SolidColorBrush x:Key="CardBorder" Color="#D8E0EA" />
      <SolidColorBrush x:Key="TextPrimary" Color="#17202B" />
      <SolidColorBrush x:Key="TextSecondary" Color="#56657A" />
      <SolidColorBrush x:Key="TextMuted" Color="#6E7D91" />
      <SolidColorBrush x:Key="Accent" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentHover" Color="#3B82F6" />
      <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE" />
      <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Danger" Color="#D64545" />
      <SolidColorBrush x:Key="Warning" Color="#C77A12" />
      <SolidColorBrush x:Key="Success" Color="#128A5B" />
      <SolidColorBrush x:Key="Gold" Color="#B8860B" />
      <SolidColorBrush x:Key="GraphBackground" Color="#F7F9FC" />
      <SolidColorBrush x:Key="GraphGrid" Color="#E3E9F1" />
      <SolidColorBrush x:Key="NodeFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NodeBorder" Color="#C9D4E2" />
      <SolidColorBrush x:Key="ChipBackground" Color="#EDF2F7" />
      <SolidColorBrush x:Key="HoverOverlay" Color="#E8EEF6" />
      <SolidColorBrush x:Key="OverlayScrim" Color="#E6F2F5F9" />
      <SolidColorBrush x:Key="RowAlt" Color="#05000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
