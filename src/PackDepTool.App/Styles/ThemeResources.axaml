<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackground" Color="#0C0D10" />
      <Color x:Key="SystemAccentColor">#D75A8A</Color>
      <Color x:Key="SystemAccentColorDark1">#BE4775</Color>
      <Color x:Key="SystemAccentColorDark2">#9F3762</Color>
      <Color x:Key="SystemAccentColorDark3">#7E2B4E</Color>
      <Color x:Key="SystemAccentColorLight1">#E57BA3</Color>
      <Color x:Key="SystemAccentColorLight2">#F0A6C0</Color>
      <Color x:Key="SystemAccentColorLight3">#F7D2E0</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#D75A8A" />
      <SolidColorBrush x:Key="HeaderBackground" Color="#131419" />
      <SolidColorBrush x:Key="PanelBackground" Color="#16171C" />
      <SolidColorBrush x:Key="PanelAlt" Color="#1E2027" />
      <SolidColorBrush x:Key="CardBorder" Color="#2B2E37" />
      <SolidColorBrush x:Key="TextPrimary" Color="#ECEDEF" />
      <SolidColorBrush x:Key="TextSecondary" Color="#A2A6B0" />
      <SolidColorBrush x:Key="TextMuted" Color="#6F7480" />
      <SolidColorBrush x:Key="Accent" Color="#D75A8A" />
      <SolidColorBrush x:Key="AccentHover" Color="#E57BA3" />
      <SolidColorBrush x:Key="AccentSoft" Color="#2D1D25" />
      <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Danger" Color="#E0665D" />
      <SolidColorBrush x:Key="Warning" Color="#E0A43A" />
      <SolidColorBrush x:Key="Success" Color="#4CC38A" />
      <SolidColorBrush x:Key="Gold" Color="#E9C46A" />
      <SolidColorBrush x:Key="GraphBackground" Color="#0E1014" />
      <SolidColorBrush x:Key="GraphGrid" Color="#1B1E25" />
      <SolidColorBrush x:Key="NodeFill" Color="#171A20" />
      <SolidColorBrush x:Key="NodeBorder" Color="#323641" />
      <SolidColorBrush x:Key="ChipBackground" Color="#20222A" />
      <SolidColorBrush x:Key="HoverOverlay" Color="#262933" />
      <SolidColorBrush x:Key="OverlayScrim" Color="#E60B0C10" />
      <SolidColorBrush x:Key="RowAlt" Color="#0AFFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackground" Color="#F2F5F9" />
      <Color x:Key="SystemAccentColor">#0369A1</Color>
      <Color x:Key="SystemAccentColorDark1">#075985</Color>
      <Color x:Key="SystemAccentColorDark2">#0C4A6E</Color>
      <Color x:Key="SystemAccentColorDark3">#082F49</Color>
      <Color x:Key="SystemAccentColorLight1">#0284C7</Color>
      <Color x:Key="SystemAccentColorLight2">#38BDF8</Color>
      <Color x:Key="SystemAccentColorLight3">#BAE6FD</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0369A1" />
      <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelAlt" Color="#F4F7FA" />
      <SolidColorBrush x:Key="CardBorder" Color="#D8E0EA" />
      <SolidColorBrush x:Key="TextPrimary" Color="#17202B" />
      <SolidColorBrush x:Key="TextSecondary" Color="#56657A" />
      <SolidColorBrush x:Key="TextMuted" Color="#6E7D91" />
      <SolidColorBrush x:Key="Accent" Color="#BE4775" />
      <SolidColorBrush x:Key="AccentHover" Color="#D75A8A" />
      <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE" />
      <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Danger" Color="#D64545" />
      <SolidColorBrush x:Key="Warning" Color="#C77A12" />
      <SolidColorBrush x:Key="Success" Color="#128A5B" />
      <SolidColorBrush x:Key="Gold" Color="#B8860B" />
      <SolidColorBrush x:Key="GraphBackground" Color="#F7F9FC" />
      <SolidColorBrush x:Key="GraphGrid" Color="#E3E9F1" />
      <SolidColorBrush x:Key="NodeFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NodeBorder" Color="#C9D4E2" />
      <SolidColorBrush x:Key="ChipBackground" Color="#EDF2F7" />
      <SolidColorBrush x:Key="HoverOverlay" Color="#E8EEF6" />
      <SolidColorBrush x:Key="OverlayScrim" Color="#E6F2F5F9" />
      <SolidColorBrush x:Key="RowAlt" Color="#05000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
